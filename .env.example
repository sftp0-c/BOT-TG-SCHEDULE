# Токен бота от @BotFather
TG_BOT_TOKEN=

# ID администраторов бота через запятую (управление в ЛС: /admin, /ban, /mute_dispatch и т.д.)
ADMIN_IDS=1075591078

# ID групповых чатов через запятую для воскресной рассылки в 18:00 с закрепом
# (можно также включать командой /autoschedule on прямо в группе или из ЛС)
WEEKLY_CHAT_IDS=

# День и время автоматической рассылки расписания на следующую неделю (0=Пн ... 6=Вс)
WEEKLY_SEND_WEEKDAY=6
WEEKLY_SEND_HOUR=18
WEEKLY_SEND_MINUTE=0

# Антиспам-ограничения (в секундах)
USER_COOLDOWN_SEC=20
CHAT_COOLDOWN_SEC=8
SAME_TARGET_COOLDOWN_SEC=30

# Прокси ТОЛЬКО для Telegram (api.telegram.org); сайт колледжа ходит напрямую.
# Пусто = без прокси. Примеры:
#   TG_PROXY=socks5://127.0.0.1:10808
#   TG_PROXY=http://127.0.0.1:7890
TG_PROXY=socks5://127.0.0.1:10808

# Страница «Расписание занятий» (можно несколько через запятую)
SCHEDULE_PAGE_URL=https://collegelan.ru/studentam/raspisanie-zanyatiy.php

# Раздел меню для автопоиска страницы расписаний, если php переименовали
SCHEDULE_MENU_URL=https://collegelan.ru/studentam/

# Запасная прямая ссылка на PDF (бот сам переберёт варианты «изм»/«(изм)»/« 1»)
SCHEDULE_DIRECT_URL=https://collegelan.ru/studentam/Расписание/25-27-25-31.pdf

# Шаблон имени PDF и целевая группа
SCHEDULE_PDF_PATTERN=25-27-25-31
TARGET_GROUP=25-28

# Час (Екб), после которого /расписание без аргументов показывает «завтра»
CUTOFF_HOUR_EKB=13
TIMEZONE=Asia/Yekaterinburg

# Тестовый режим без сайта: путь к PDF внутри контейнера (/app/samples/schedules/...)
# SCHEDULE_LOCAL_PDF=/app/samples/schedules/25-27-25-31_00e8da94d0354de8.pdf
