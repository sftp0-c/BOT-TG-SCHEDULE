# Токен бота от @BotFather
TG_BOT_TOKEN=

# Прокси ТОЛЬКО для Telegram (api.telegram.org); сайт колледжа ходит напрямую.
# Пусто = без прокси. Примеры:
#   TG_PROXY=socks5://127.0.0.1:1080
#   TG_PROXY=http://127.0.0.1:7890
TG_PROXY=

# Страница «Расписание занятий». Можно несколько через запятую — проверятся
# по порядку. На странице бот ищет PDF-ссылку с шаблоном ниже в имени файла.
SCHEDULE_PAGE_URL=https://collegelan.ru/studentam/raspisanie-zanyatiy.php

# Раздел, в меню которого есть ссылка «Расписание занятий»: если php-страницу
# выше переименовали/перенесли, бот найдёт её заново по этому разделу.
SCHEDULE_MENU_URL=https://collegelan.ru/studentam/

# Прямая ссылка на PDF (запасной вариант, если страницы не открылись).
# Бот сам переберёт варианты «изм»/«(изм)»/пробелы вокруг неё.
SCHEDULE_DIRECT_URL=https://collegelan.ru/studentam/Расписание/25-27-25-31 1.pdf

# Шаблон имени PDF, в котором встречается расписание для группы
SCHEDULE_PDF_PATTERN=25-27-25-31

# Группа, которую вырезаем/ищем внутри файла
TARGET_GROUP=25-28

# Час (Екб), после которого «сегодня» считается «завтра»
CUTOFF_HOUR_EKB=13

# Тестовый режим без сайта: путь к PDF на диске (закомментирован — берём с сайта)
# SCHEDULE_LOCAL_PDF=C:\путь\к\файлу.pdf
